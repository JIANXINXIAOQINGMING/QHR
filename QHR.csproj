<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QHR.Overtime</AssemblyName>
    <RootNamespace>QHR</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.3.20</Version>
    <AssemblyVersion>1.3.20.0</AssemblyVersion>
    <FileVersion>1.3.20.0</FileVersion>
    <InformationalVersion>1.3.20</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.ico" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
