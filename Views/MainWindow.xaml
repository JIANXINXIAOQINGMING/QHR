                                                <DataGridTextColumn Header="年份" Binding="{Binding Period}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="加班日期数" Binding="{Binding OvertimeDays}" Width="110"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="折算天数" Binding="{Binding EquivalentDays, StringFormat=0.##}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="加班(h)" Binding="{Binding TotalHours, StringFormat=0.##}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="延时抵扣(h)" Binding="{Binding DelayDeductedHours, StringFormat=0.##}" Width="110"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="115"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="餐补次数" Binding="{Binding MealAllowanceCount}" Width="95"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="95"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="总计" Binding="{Binding TotalAmount, StringFormat=¥ {0:N2}}" Width="115"
