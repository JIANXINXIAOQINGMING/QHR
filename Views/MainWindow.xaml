                                                        <DataTemplate>
                                                            <Grid Width="76" Height="226" Margin="2,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="38" />
                                                                    <RowDefinition Height="158" />
                                                                    <RowDefinition Height="30" />
