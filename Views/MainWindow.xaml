<Window x:Class="QHR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QHR.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QHR 加班助手" Icon="/Assets/AppIcon.ico" Width="1380" Height="860"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="{StaticResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Margin="0" CornerRadius="0" Background="{StaticResource WindowBackgroundBrush}"
            BorderThickness="0" Effect="{x:Null}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#52FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="19,0,0,0">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="Q" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="QHR 加班助手" FontSize="15" FontWeight="SemiBold" Margin="11,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="HeaderStatusText" Grid.Column="1" Text="已连接 QHR"
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="ProfileButton" Background="Transparent" BorderThickness="0" Padding="7,3"
                            Effect="{x:Null}" ToolTip="账户菜单" Click="ProfileButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ProfileContextMenu" Placement="Bottom" MinWidth="210">
                                <MenuItem IsEnabled="False">
                                    <MenuItem.Header>
                                        <StackPanel Margin="4,3,4,5">
                                            <TextBlock x:Name="ProfileMenuUsernameText" Text="用户" FontWeight="SemiBold" />
                                            <TextBlock Text="QHR 已连接" Foreground="{StaticResource SuccessBrush}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="刷新当前数据" Click="ProfileRefreshMenuItem_Click" />
                                <MenuItem Header="检查更新" Click="CheckForUpdatesMenuItem_Click" />
                                <MenuItem Header="QHR 请求诊断" Click="OpenDiagnosticsMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="备份全部数据" Click="BackupAllDataMenuItem_Click" />
                                <MenuItem Header="导入备份" Click="ImportBackupMenuItem_Click" />
                                <Separator />
                                <MenuItem x:Name="VersionMenuItem" Header="版本 v1.3.24" IsEnabled="False" />
                                <MenuItem Header="退出登录" Foreground="{StaticResource DangerBrush}" Click="LogoutButton_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="HeaderUsernameText" Text="用户" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="在线" Foreground="{StaticResource SuccessBrush}" FontSize="10" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrandBrush}">
                                <TextBlock x:Name="AvatarText" Text="U" Foreground="White" FontWeight="Bold"
                                           FontSize="15" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="最小化"
                            AutomationProperties.Name="最小化" Click="MinimizeButton_Click">
                        <Grid Width="16" Height="16">
                            <Path Data="M 2,8 L 14,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource IconButtonStyle}" ToolTip="最大化"
                            AutomationProperties.Name="最大化" Click="MaximizeButton_Click">
                        <Grid Width="16" Height="16">
                            <Path x:Name="MaximizeGlyph" Data="M 2.5,2.5 L 13.5,2.5 13.5,13.5 2.5,13.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35" SnapsToDevicePixels="True" />
                            <Path x:Name="RestoreGlyph" Data="M 5,2.5 L 13.5,2.5 13.5,11 M 2.5,5 L 11,5 11,13.5 2.5,13.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35" SnapsToDevicePixels="True" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="关闭"
                            AutomationProperties.Name="关闭" Click="CloseButton_Click">
                        <Grid Width="16" Height="16">
                            <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="14,10,8,14" Padding="13" Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="工作台" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   FontWeight="SemiBold" Margin="10,5,0,13" />
                        <StackPanel Grid.Row="1">
                            <Button x:Name="OverviewNavButton" Style="{StaticResource NavButtonStyle}" Tag="0" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="⌂" Style="{StaticResource NavIconTextStyle}" /><TextBlock Grid.Column="1" Text="概览" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid>
                            </Button>
                            <Button x:Name="AnalyticsNavButton" Style="{StaticResource NavButtonStyle}" Tag="1" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="▥" Style="{StaticResource NavIconTextStyle}" /><TextBlock Grid.Column="1" Text="分析汇总" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid>
                            </Button>
                            <Button x:Name="GoalNavButton" Style="{StaticResource NavButtonStyle}" Tag="5" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="◎" Style="{StaticResource NavIconTextStyle}" /><TextBlock Grid.Column="1" Text="加班目标" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid>
                            </Button>
                            <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Tag="4" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="⚙" Style="{StaticResource NavIconTextStyle}" /><TextBlock Grid.Column="1" Text="计算设置" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" Background="#151473E6" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="数据安全" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="密码由 Windows 凭据保管" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TabControl x:Name="ContentTabs" Grid.Column="1" SelectedIndex="0"
                            Style="{StaticResource HiddenTabControlStyle}" Margin="8,10,14,14">
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,5,8,18">
                                <TextBlock Text="加班概览" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="从 QHR 打卡记录计算并汇总加班时间与预估费用。"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,7,0,20" />

                                <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="统计月份" FontWeight="SemiBold" Margin="0,0,16,0" />
                                        <ComboBox x:Name="OverviewYearComboBox" Grid.Column="1"
                                                  ItemStringFormat="{}{0} 年"
                                                  SelectionChanged="OverviewMonthComboBox_SelectionChanged" />
                                        <ComboBox x:Name="OverviewMonthComboBox" Grid.Column="3"
                                                  ItemStringFormat="{}{0:00} 月"
                                                  SelectionChanged="OverviewMonthComboBox_SelectionChanged" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0">
                                            <Button x:Name="PreviousMonthButton" Content="上个月" Padding="13,7" Margin="0,0,8,0" Click="PreviousMonthButton_Click" />
                                            <Button x:Name="NextMonthButton" Content="下个月" Padding="13,7" Margin="0,0,8,0" Click="NextMonthButton_Click" />
                                            <Button x:Name="CurrentMonthButton" Content="本月" Padding="13,7" Click="CurrentMonthButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#321473E6" BorderBrush="#291473E6" BorderThickness="1"
                                        CornerRadius="12" Padding="15,11" Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock x:Name="OverviewStatusText" Text="正在准备考勤、节假日与本地档案状态…"
                                                   Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="9*" />
                                        <ColumnDefinition Width="18.5*" />
                                        <ColumnDefinition Width="6.25*" />
                                        <ColumnDefinition Width="6.25*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="本月加班" Style="{StaticResource MutedTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                                <TextBlock x:Name="TotalHoursText" Text="0" FontSize="30" FontWeight="SemiBold" />
                                                <TextBlock Text=" 小时" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                                            </StackPanel>
                                            <TextBlock x:Name="RangeText" Text="等待刷新" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="加班费预估" Style="{StaticResource MutedTextStyle}" />
                                            <Grid Margin="0,9,0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="预估到手 / 总加班费" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock x:Name="TotalAmountText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}" />
                                                    <TextBlock Text=" / " FontSize="23" FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedBrush}" Margin="3,0" />
                                                    <TextBlock x:Name="GrossOvertimePayText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="CapImpactText" Text="未启用加班费封顶"
                                                       Style="{StaticResource MutedTextStyle}" FontSize="11"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="加班日期数" Style="{StaticResource MutedTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                                <TextBlock x:Name="OvertimeDaysText" Text="0" FontSize="30" FontWeight="SemiBold" />
                                                <TextBlock Text=" 天" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                                            </StackPanel>
                                            <TextBlock x:Name="AverageHoursText" Text="日均 0 小时" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource GlassCardStyle}" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="餐补次数" Style="{StaticResource MutedTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                                <TextBlock x:Name="MealAllowanceCountText" Text="0" FontSize="30" FontWeight="SemiBold" />
                                                <TextBlock Text=" 次" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                                            </StackPanel>
                                            <TextBlock x:Name="MealAllowanceAmountText" Text="餐补合计 ¥ 0.00" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="月度加班日历" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="CalendarMonthSummaryText" Text="正在准备本月数据…"
                                                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="点击日期查看当天详情" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}" Margin="0,0,12,0" />
                                                <Button Content="导出本年" Padding="13,7" Margin="0,0,8,0" Click="ExportYearEvidenceButton_Click" />
                                                <Button Content="导出本月" Padding="13,7" Click="ExportMonthEvidenceButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,15,0,7">
                                            <TextBlock Text="周一" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="周二" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="周三" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="周四" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="周五" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="周六" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="周日" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        </UniformGrid>
                                        <ItemsControl x:Name="OvertimeCalendar" Grid.Row="2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="4" Padding="10,8" MinHeight="84" CornerRadius="11"
                                                            Cursor="Hand" MouseLeftButtonUp="CalendarDay_MouseLeftButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#64FFFFFF" />
                                                                <Setter Property="BorderBrush" Value="#306A819C" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="Cursor" Value="Arrow" />
                                                                        <Setter Property="IsHitTestVisible" Value="False" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasOvertime}" Value="True">
                                                                        <Setter Property="Background" Value="#171473E6" />
                                                                        <Setter Property="BorderBrush" Value="#521473E6" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <TextBlock Text="{Binding DayText}" FontSize="15" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding KindText}" FontSize="10" HorizontalAlignment="Right">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource HolidayBrush}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Text="{Binding LeaveText}" FontSize="11" FontWeight="SemiBold"
                                                                       Margin="0,5,0,1" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource HolidayBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasPersonalLeave}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Row="2" Text="{Binding HoursText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentBrush}" Margin="0,3,0,1" />
                                                            <TextBlock Grid.Row="3" Text="{Binding AmountText}" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource HolidayBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,5,8,18">
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="分析汇总" Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock x:Name="AnalyticsRangeText" Text="独立读取今年各月份，并与往年数据对比。"
                                                   Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,9"
                                            Background="#76FFFFFF" BorderBrush="#306A819C" BorderThickness="1" CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="分析范围" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <ComboBox x:Name="AnalyticsRangeModeComboBox" Width="138" SelectedIndex="0"
                                                      SelectionChanged="AnalyticsRangeModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="单个年度" />
                                                <ComboBoxItem Content="近三年" />
                                                <ComboBoxItem Content="近五年" />
                                                <ComboBoxItem Content="近十年" />
                                            </ComboBox>
                                            <ComboBox x:Name="AnalyticsYearComboBox" Width="108" Margin="10,0,0,0" IsEnabled="True"
                                                      SelectionChanged="AnalyticsYearComboBox_SelectionChanged" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="5" Margin="0,0,0,16">
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="加班费（实际 / 总）" Style="{StaticResource MutedTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock x:Name="AnalyticsOvertimePayText" Text="¥ 0.00" FontSize="21" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                                <TextBlock Text=" / " FontSize="19" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock x:Name="AnalyticsGrossOvertimePayText" Text="¥ 0.00" FontSize="21" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="封顶无效" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="AnalyticsCapExcludedHoursText" Text="0h00m" FontSize="23" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" />
                                            <TextBlock x:Name="AnalyticsCapDeductedPayText" Text="少计 ¥ 0.00"
                                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="餐补次数" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="AnalyticsMealCountText" Text="0 次" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="餐补金额" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="AnalyticsMealAmountText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="费用总计" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="AnalyticsTotalAmountText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18">
