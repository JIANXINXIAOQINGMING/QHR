                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="43" Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="250" />
                                                                <ColumnDefinition Width="70" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                            <Border Grid.Column="1" Height="14" CornerRadius="7" Background="#101473E6">
                                                                <Border Width="{Binding BarLength}" Height="14" CornerRadius="7"
                                                                        Background="{StaticResource BrandBrush}" HorizontalAlignment="Left" />
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" FontSize="11"
                                                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <DataGrid x:Name="AnalyticsYearDataGrid" Grid.Column="2" AutoGenerateColumns="False" MinHeight="190"
