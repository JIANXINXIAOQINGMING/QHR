                                            <ColumnDefinition Width="390" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="年度加班费" Style="{StaticResource SectionTitleStyle}" />
