                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="4" Padding="11,9" MinHeight="82" CornerRadius="11"
                                                            Cursor="Hand" MouseLeftButtonUp="ExpenseCalendarDay_MouseLeftButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#64FFFFFF" />
                                                                <Setter Property="BorderBrush" Value="#306A819C" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="IsHitTestVisible" Value="False" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasExpense}" Value="True">
                                                                        <Setter Property="Background" Value="#17E45C78" />
                                                                        <Setter Property="BorderBrush" Value="#52E45C78" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.43" />
                                                                        <Setter Property="Cursor" Value="Arrow" />
                                                                        <Setter Property="IsHitTestVisible" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
