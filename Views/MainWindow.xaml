                                                            <TextBlock Grid.Row="1" Text="{Binding AmountText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource DangerBrush}" Margin="0,8,0,2" />
                                                            <TextBlock Grid.Row="2" Text="{Binding CountText}" FontSize="11"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
