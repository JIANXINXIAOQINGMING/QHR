                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="添加图片" Padding="13,7" Margin="0,0,8,0" Click="AddEvidenceImageButton_Click" />
                                        <Button Content="导出当天资料" Padding="13,7" Click="ExportDayEvidenceButton_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="DayEvidenceNoteTextBox" MinHeight="72" MaxLength="2000" Padding="11,8"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             ToolTip="记录加班原因、事项或补充说明" />
                                    <Button Grid.Column="1" Content="保存备注" Padding="14,8" Margin="10,0,0,0"
                                            VerticalAlignment="Bottom" Click="SaveDayEvidenceNoteButton_Click" />
                                </Grid>

                                <Grid Margin="0,13,0,0">
                                    <TextBlock x:Name="DayEvidenceEmptyText" Text="暂无证据图片，可添加截图或照片"
                                               Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="DayEvidenceItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="146" Padding="7" Margin="0,0,10,0" Background="#54FFFFFF"
                                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9">
                                                        <StackPanel>
                                                            <Border Height="88" CornerRadius="6" ClipToBounds="True" Background="#180C1726">
                                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                                                                       Margin="2,7,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                                            <Grid Margin="2,4,2,0">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                                <Button Content="删除" Padding="5,1" FontSize="10" HorizontalAlignment="Right"
                                                                        Foreground="{StaticResource DangerBrush}" Background="Transparent"
                                                                        BorderThickness="0" Effect="{x:Null}" Click="DeleteEvidenceImageButton_Click" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                                <TextBlock x:Name="DayEvidenceStatusText" Text="最多 30 张，单张不超过 20 MB"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </Border>

            <Border x:Name="ExpenseDetailOverlay" Grid.Row="1" Panel.ZIndex="120" Visibility="Collapsed"
                    Background="#8A0C1726" IsHitTestVisible="True">
                <Border Width="760" MaxHeight="780" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource GlassCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,5,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="ExpenseDetailTitleText" Text="当天消费" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ExpenseDetailSummaryText" Text="暂无消费记录"
                                               Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Content="×" Width="34" Height="34" Padding="0" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Effect="{x:Null}"
                                        FontSize="22" Click="CloseExpenseDetailButton_Click" />
                            </Grid>

                            <Border Background="#42FFFFFF" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="当天账单" FontSize="16" FontWeight="SemiBold" />
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock x:Name="ExpenseDayEmptyText" Text="当天还没有消费，记下第一笔吧"
                                                   Style="{StaticResource MutedTextStyle}" Margin="2,5,0,6" />
                                        <ItemsControl x:Name="ExpenseDayItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#52FFFFFF" BorderBrush="#246E819C" BorderThickness="1"
                                                            CornerRadius="9" Padding="13,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=¥ {0:N2}}"
                                                                       Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" Margin="20,0,16,0" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <Button Content="修改" Padding="8,3" Margin="0,0,4,0"
                                                                        Foreground="{StaticResource AccentBrush}" Background="Transparent"
                                                                        BorderThickness="0" Effect="{x:Null}" Click="EditExpenseButton_Click" />
                                                                <Button Content="删除" Padding="8,3"
                                                                        Foreground="{StaticResource DangerBrush}" Background="Transparent"
                                                                        BorderThickness="0" Effect="{x:Null}" Click="DeleteExpenseButton_Click" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#42FFFFFF" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ExpenseEntryTitleText" Text="记一笔消费" FontSize="16" FontWeight="SemiBold" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="消费说明" Margin="0,0,0,7" />
                                            <TextBox x:Name="ExpenseDescriptionTextBox" MaxLength="100"
                                                     ToolTip="例如：午餐、交通、日用品" />
                                            <TextBlock Text="写清买了什么，之后查账更方便" Style="{StaticResource MutedTextStyle}"
                                                       FontSize="11" Margin="2,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="消费日期" Margin="0,0,0,7" />
                                            <DatePicker x:Name="ExpenseDatePicker" />
                                            <TextBlock Text="可修正填错的日期" Style="{StaticResource MutedTextStyle}"
                                                       FontSize="11" Margin="2,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="消费金额（元）" Margin="0,0,0,7" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ExpenseAmountTextBox" MaxLength="15" VerticalContentAlignment="Center"
                                                         PreviewTextInput="ExpenseAmountTextBox_PreviewTextInput"
                                                         DataObject.Pasting="ExpenseAmountTextBox_Pasting"
                                                         ToolTip="只允许输入数字，最多两位小数" />
                                                <Button Grid.Column="1" Width="42" Height="38" Padding="0" Margin="8,0,0,0"
                                                        ToolTip="打开金额计算器" AutomationProperties.Name="打开金额计算器"
                                                        Click="ToggleExpenseCalculatorButton_Click">
                                                    <Viewbox Width="20" Height="24" Stretch="Uniform">
                                                        <Grid Width="18" Height="22">
                                                            <Border Background="#FF4C5868" BorderBrush="#FF354151"
                                                                    BorderThickness="1" CornerRadius="2" />
                                                            <Border Margin="2.5,2.5,2.5,12.5" Background="#FF72D2EE"
                                                                    CornerRadius="0.8" />
                                                            <UniformGrid Rows="3" Columns="3" Margin="2.2,10.2,2.2,2.2">
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FFD7DEE6" CornerRadius="0.5" />
                                                                <Border Margin="0.7" Background="#FF3984D7" CornerRadius="0.5" />
                                                            </UniformGrid>
                                                        </Grid>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="仅支持非负数字，最多两位小数" Style="{StaticResource MutedTextStyle}"
                                                       FontSize="11" Margin="2,5,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="ExpenseCalculatorPanel" Visibility="Collapsed" Margin="0,14,0,0"
                                            Background="#461473E6" BorderBrush="#421473E6" BorderThickness="1"
                                            CornerRadius="11" Padding="12" Focusable="True"
                                            PreviewKeyDown="ExpenseCalculatorPanel_PreviewKeyDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="金额计算器" FontWeight="SemiBold" />
                                                <TextBox x:Name="ExpenseCalculatorDisplayTextBox" Text="0" IsReadOnly="True"
                                                         FontSize="24" FontWeight="SemiBold" TextAlignment="Right"
                                                         Margin="0,10,0,0" Padding="10,7" />
                                                <TextBlock Text="支持键盘与数字小键盘；Enter 计算，Esc 关闭" Style="{StaticResource MutedTextStyle}"
                                                           FontSize="11" Margin="2,7,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <UniformGrid Grid.Column="2" Columns="4">
                                                <Button Content="C" Tag="clear" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="⌫" Tag="back" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="÷" Tag="/" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="×" Tag="*" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="7" Tag="7" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="8" Tag="8" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="9" Tag="9" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="−" Tag="-" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="4" Tag="4" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="5" Tag="5" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="6" Tag="6" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="+" Tag="+" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="1" Tag="1" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="2" Tag="2" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="3" Tag="3" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="=" Tag="=" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="0" Tag="0" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="." Tag="." Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="关闭" Tag="cancel" Margin="3" Height="38" Click="ExpenseCalculatorButton_Click" />
                                                <Button Content="使用" Tag="use" Margin="3" Height="38" Style="{StaticResource AccentButtonStyle}"
                                                        Click="ExpenseCalculatorButton_Click" />
                                            </UniformGrid>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,15,0,0">
                                        <TextBlock x:Name="ExpenseEntryStatusText" Text="日期由当前打开的日历格确定"
                                                   Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CancelExpenseEditButton" Content="取消修改" Padding="16,8" Margin="0,0,8,0"
                                                    Visibility="Collapsed" Click="CancelExpenseEditButton_Click" />
                                            <Button x:Name="SaveExpenseButton" Content="保存这笔消费" Style="{StaticResource AccentButtonStyle}" Padding="18,8"
                                                    Click="AddExpenseButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <Border x:Name="CompletedGoalEditOverlay" Grid.Row="1" Panel.ZIndex="130" Visibility="Collapsed"
                    Background="#8A0C1726" IsHitTestVisible="True">
                <Border Width="720" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource GlassCardStyle}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="修改已完成目标" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="可修正名称、金额、日期和收入方式；已归档的加班与消费快照保持不变。"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Content="×" Width="34" Height="34" Padding="0" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Effect="{x:Null}"
                                    FontSize="22" Click="CloseCompletedGoalEditButton_Click" />
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="目标名称" Margin="0,0,0,7" />
                                <TextBox x:Name="CompletedGoalNameTextBox" MaxLength="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目标金额（元）" Margin="0,0,0,7" />
                                <TextBox x:Name="CompletedGoalTargetAmountTextBox" MaxLength="15" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="起算日" Margin="0,0,0,7" />
                                <DatePicker x:Name="CompletedGoalStartDatePicker" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="完成日" Margin="0,0,0,7" />
                                <DatePicker x:Name="CompletedGoalCompletedDatePicker" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="收入计算方式" Margin="0,0,0,7" />
                            <ComboBox x:Name="CompletedGoalIncomeModeComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="只算加班费" />
                                <ComboBoxItem Content="加班费 + 餐补" />
                            </ComboBox>
                        </StackPanel>
                        <Grid Margin="0,22,0,0">
                            <TextBlock x:Name="CompletedGoalEditStatusText" Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Padding="18,8" Margin="0,0,8,0"
                                        Click="CloseCompletedGoalEditButton_Click" />
                                <Button Content="保存修改" Padding="20,8" Style="{StaticResource AccentButtonStyle}"
                                        Click="SaveCompletedGoalEditButton_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="GoalCelebrationOverlay" Grid.Row="1" Panel.ZIndex="140" Visibility="Collapsed"
                    Background="#B20C1726" IsHitTestVisible="True">
                <Grid x:Name="GoalCelebrationRoot" ClipToBounds="True">
                    <Canvas x:Name="GoalCelebrationConfettiCanvas" IsHitTestVisible="False" />
                    <Border x:Name="GoalCelebrationCard" Width="640" Padding="36,32"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource GlassCardStyle}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="GoalCelebrationScale" ScaleX="0.75" ScaleY="0.75" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                                    Background="#1F199C6C" BorderBrush="#52199C6C" BorderThickness="1">
                                <TextBlock Text="✓" FontSize="39" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="恭喜，目标达成！" FontSize="29" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock x:Name="GoalCelebrationNameText" Text="目标已完成并归档"
                                       Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <UniformGrid Columns="3" Margin="0,24,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="目标价格" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="GoalCelebrationAmountText" Text="¥ 0.00" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="完成时长" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="GoalCelebrationDurationText" Text="0 天" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="累计加班" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="GoalCelebrationOvertimeText" Text="0h00m" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="GoalCelebrationSummaryText" Text="完成信息已安全保存到历史目标"
                                       Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
                            <Button Content="查看已完成目标" Style="{StaticResource AccentButtonStyle}" Padding="24,10"
                                    HorizontalAlignment="Center" Margin="0,22,0,0"
                                    Click="ViewCompletedGoalsButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="RefreshOverlay" Grid.Row="1" Panel.ZIndex="100" Visibility="Collapsed"
                    Background="#82EDF4FA" IsHitTestVisible="True">
                <Border Width="380" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource GlassCardStyle}">
                    <StackPanel>
                        <TextBlock Text="正在刷新数据" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RefreshOverlayStatusText" Text="正在读取 QHR 数据，请稍候…"
                                   Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,9,0,16" />
                        <ProgressBar Height="6" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                                     Background="#241473E6" BorderThickness="0" />
                        <TextBlock Text="刷新完成后页面会自动恢复操作" Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
