                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="8,5,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="工时明细" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="在每日、月度和年度三个粒度之间切换。" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,18" />
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <TabControl x:Name="DetailTabs">
                                    <TabItem Header="每日明细">
                                        <DataGrid x:Name="DailyDataGrid" Margin="0,14,0,0" AutoGenerateColumns="False"
                                                  GridLinesVisibility="All" VerticalGridLinesBrush="{StaticResource LineBrush}"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="118"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="首卡" Binding="{Binding ClockInText}" Width="72"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="末卡" Binding="{Binding ClockOutText}" Width="72"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="日期类型" Binding="{Binding DateTypeText}" Width="145">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredDataGridTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DayKind.Holiday}">
                                                                    <Setter Property="Foreground" Value="{StaticResource HolidayBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="原始加班" Binding="{Binding GrossDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="延时抵扣" Binding="{Binding DelayDeductedDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="请假抵扣" Binding="{Binding LeaveDeductedDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="实算加班" Binding="{Binding HoursDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="105">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredDataGridTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DayKind.Holiday}">
                                                                    <Setter Property="Foreground" Value="{StaticResource HolidayBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="合计" Binding="{Binding Amount, StringFormat=¥ {0:N2}}" Width="105"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="月度汇总">
                                        <DataGrid x:Name="MonthlyDataGrid" Margin="0,14,0,0" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="月份" Binding="{Binding Period}" Width="*" />
                                                <DataGridTextColumn Header="加班日期数" Binding="{Binding OvertimeDays}" Width="110" />
                                                <DataGridTextColumn Header="折算天数(8h/天)" Binding="{Binding EquivalentDays, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="工作日(h)" Binding="{Binding WorkdayHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="周末(h)" Binding="{Binding WeekendHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="节假日(h)" Binding="{Binding HolidayHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="合计(h)" Binding="{Binding TotalHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="延时抵扣(h)" Binding="{Binding DelayDeductedHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="请假(h)" Binding="{Binding LeaveHours, StringFormat=0.##}" Width="100" />
                                                <DataGridTextColumn Header="已抵扣(h)" Binding="{Binding LeaveDeductedHours, StringFormat=0.##}" Width="105" />
                                                <DataGridTextColumn Header="加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="115" />
                                                <DataGridTextColumn Header="餐补次数" Binding="{Binding MealAllowanceCount}" Width="100" />
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="100" />
                                                <DataGridTextColumn Header="总计" Binding="{Binding TotalAmount, StringFormat=¥ {0:N2}}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="年度汇总">
                                        <DataGrid x:Name="YearlyDataGrid" Margin="0,14,0,0" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="年份" Binding="{Binding Period}" Width="*" />
                                                <DataGridTextColumn Header="加班日期数" Binding="{Binding OvertimeDays}" Width="120" />
                                                <DataGridTextColumn Header="折算天数(8h/天)" Binding="{Binding EquivalentDays, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="工作日(h)" Binding="{Binding WorkdayHours, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="周末(h)" Binding="{Binding WeekendHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="节假日(h)" Binding="{Binding HolidayHours, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="合计(h)" Binding="{Binding TotalHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="延时抵扣(h)" Binding="{Binding DelayDeductedHours, StringFormat=0.##}" Width="115" />
                                                <DataGridTextColumn Header="请假(h)" Binding="{Binding LeaveHours, StringFormat=0.##}" Width="105" />
                                                <DataGridTextColumn Header="已抵扣(h)" Binding="{Binding LeaveDeductedHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="120" />
                                                <DataGridTextColumn Header="餐补次数" Binding="{Binding MealAllowanceCount}" Width="105" />
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="105" />
                                                <DataGridTextColumn Header="总计" Binding="{Binding TotalAmount, StringFormat=¥ {0:N2}}" Width="125" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="8,5,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="节假日日历" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="法定节假日和调休工作日会覆盖普通周末判断。" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,18" />
                                </StackPanel>
                                <Button x:Name="SyncHolidayButton" Content="立即同步" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Style="{StaticResource AccentButtonStyle}" Click="SyncHolidayButton_Click" />
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="同步状态" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HolidayDetailStatusText" Grid.Column="1" Text="尚未同步" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="1" Text="数据源" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBox x:Name="HolidaySourceDisplayTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                             Margin="0,10,0,0" BorderThickness="0" Background="Transparent" Padding="0" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <DataGrid x:Name="HolidayDataGrid" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="180" />
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,5,8,18">
                                <TextBlock Text="计算设置" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="费率、弹性班次、请假抵扣、餐补和取整规则修改后会立即重算当前结果。"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,7,0,18" />

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="费用参数" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="工作日" Margin="0,0,0,7" /><TextBox x:Name="WorkdayRateTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="周末" Margin="0,0,0,7" /><TextBox x:Name="WeekendRateTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="节假日（元 / 小时）" Margin="0,0,0,7" /><TextBox x:Name="HolidayRateTextBox" /></StackPanel>
                                            <StackPanel><TextBlock Text="每次餐补（元）" Margin="0,0,0,7" /><TextBox x:Name="MealAllowanceTextBox" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="工时计算规则" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                                        <UniformGrid Columns="4" Margin="0,0,0,15">
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="最早上班（HH:mm）" Margin="0,0,0,7" /><TextBox x:Name="FlexibleStartEarliestTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="最晚上班（HH:mm）" Margin="0,0,0,7" /><TextBox x:Name="FlexibleStartLatestTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="标准在岗跨度（小时）" Margin="0,0,0,7" /><TextBox x:Name="StandardWorkSpanTextBox" /></StackPanel>
                                            <StackPanel><TextBlock Text="工作日起算（HH:mm）" Margin="0,0,0,7" /><TextBox x:Name="WorkdayStartTextBox" /></StackPanel>
                                        </UniformGrid>
                                        <UniformGrid Columns="4" Margin="0,0,0,14">
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="最小加班小时" Margin="0,0,0,7" /><TextBox x:Name="MinimumHoursTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="向下取整分钟" Margin="0,0,0,7" /><TextBox x:Name="RoundingMinutesTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="工作日餐补门槛（小时）" Margin="0,0,0,7" /><TextBox x:Name="WorkdayMealHoursTextBox" /></StackPanel>
                                            <StackPanel><TextBlock Text="周末 / 节假日餐补门槛" Margin="0,0,0,7" /><TextBox x:Name="NonWorkdayMealHoursTextBox" /></StackPanel>
                                        </UniformGrid>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="DeductLeaveCheckBox" Content="从当月加班中抵扣 QHR 请假 / 缺勤时数" Margin="0,0,28,0" />
                                            <TextBlock Text="周末和节假日按首末卡直算，不扣休息" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="节假日更新" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                                        <CheckBox x:Name="AutoSyncCheckBox" Content="每天首次使用时自动同步" Margin="0,0,0,12" />
                                        <TextBlock Text="全年 JSON 地址（使用 {year} 作为年份占位符）" Margin="0,0,0,7" />
                                        <TextBox x:Name="HolidaySourceTextBox" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="软件更新" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="SettingsVersionText" Text="当前版本 v1.2"
                                                   Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14" />
                                        <TextBlock Text="远程 update.json 地址（可选；留空时检查程序目录中的清单）" Margin="0,0,0,7" />
                                        <TextBox x:Name="UpdateManifestUrlTextBox" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                    <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource SuccessBrush}" Margin="0,0,14,0" />
                                    <Button Content="恢复默认" Margin="0,0,10,0" Click="ResetSettingsButton_Click" />
                                    <Button Content="保存并重新计算" Style="{StaticResource AccentButtonStyle}" Click="SaveSettingsButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,5,8,18">
                                <TextBlock Text="加班目标" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="用加班费追踪一个购买目标；额外消费会从已积累的有效金额中扣除。"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,7,0,18" />

                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="目标金额" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="GoalTargetSummaryText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="GoalEarnedLabelText" Text="累计加班费" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="GoalEarnedSummaryText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="已记录消费" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="GoalExpensesSummaryText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="实际有效金额" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="GoalEffectiveSummaryText" Text="¥ 0.00" FontSize="25" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="340" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="GoalTitleText" Text="目标进度" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock x:Name="GoalScopeText" Text="按起算日后的加班费统计" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,15" />
                                            <ProgressBar x:Name="GoalProgressBar" Height="16" Minimum="0" Maximum="100" Value="0"
                                                         Foreground="{StaticResource AccentBrush}" Background="#181473E6" BorderThickness="0" />
                                            <TextBlock x:Name="GoalProgressText" Text="0%" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="30,0,8,0" Padding="22,18" CornerRadius="14"
                                                Background="#52FFFFFF" BorderBrush="#246E819C" BorderThickness="1">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="GoalRemainingText" Text="还差 ¥ 0.00" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock x:Name="GoalEstimatedHoursText" Text="预计还需加班 0 小时"
                                                           Style="{StaticResource MutedTextStyle}" Margin="0,9,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="目标设置" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="目标名称" Margin="0,0,0,7" />
                                                <TextBox x:Name="GoalNameTextBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="目标金额（元）" Margin="0,0,0,7" />
                                                <TextBox x:Name="GoalTargetAmountTextBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="加班费起算日" Margin="0,0,0,7" />
                                                <DatePicker x:Name="GoalStartDatePicker" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="收入计算方式" Margin="0,0,0,7" />
                                                <ComboBox x:Name="GoalIncomeModeComboBox" SelectedIndex="0">
                                                    <ComboBoxItem Content="只算加班费" />
                                                    <ComboBoxItem Content="加班费 + 餐补" />
                                                </ComboBox>
                                            </StackPanel>
                                            <Button Grid.Column="7" Content="保存目标" Style="{StaticResource AccentButtonStyle}"
                                                    Margin="16,25,0,0" Click="SaveGoalButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="GoalStatusText" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="260" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="消费记录" Style="{StaticResource SectionTitleStyle}" />
                                        <Grid Grid.Row="1" Margin="0,15,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <DatePicker x:Name="ExpenseDatePicker" />
                                            <TextBox x:Name="ExpenseDescriptionTextBox" Grid.Column="2" ToolTip="消费说明" />
                                            <TextBox x:Name="ExpenseAmountTextBox" Grid.Column="4" ToolTip="消费金额（元）" />
                                            <Button Grid.Column="5" Content="添加消费" Margin="14,0,0,0" Click="AddExpenseButton_Click" />
                                        </Grid>
                                        <DataGrid x:Name="GoalExpensesDataGrid" Grid.Row="2" AutoGenerateColumns="False">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="160"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=¥ {0:N2}}" Width="180"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTemplateColumn Header="操作" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="删除" Padding="10,5" Foreground="{StaticResource DangerBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Background="Transparent" BorderThickness="0" Effect="{x:Null}"
                                                                    Click="DeleteExpenseButton_Click" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border x:Name="DayDetailOverlay" Grid.Row="1" Panel.ZIndex="110" Visibility="Collapsed"
                    Background="#8A0C1726" IsHitTestVisible="True">
                <Border Width="760" MaxHeight="760" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource GlassCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="DayDetailTitleText" Text="当天详情" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="DayDetailSubtitleText" Text="日期类型" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Content="✕" Width="34" Height="34" Padding="0" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Style="{StaticResource IconButtonStyle}" Click="CloseDayDetailButton_Click" />
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,16">
                            <Border Background="#58FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,9,0">
                                <StackPanel><TextBlock Text="首卡" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="DayDetailClockInText" Text="--:--" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                            </Border>
                            <Border Background="#58FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,9,0">
                                <StackPanel><TextBlock Text="末卡" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="DayDetailClockOutText" Text="--:--" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                            </Border>
                            <Border Background="#58FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,9,0">
                                <StackPanel><TextBlock Text="实算加班" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="DayDetailActualText" Text="0h00m" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,7,0,0" /></StackPanel>
                            </Border>
                            <Border Background="#58FFFFFF" CornerRadius="12" Padding="15">
                                <StackPanel><TextBlock Text="餐补次数" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="DayDetailMealCountText" Text="0 次" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Background="#42FFFFFF" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="17,14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="原始加班" Margin="0,4" />
                                <TextBlock x:Name="DayDetailGrossText" Grid.Column="1" Text="0h00m" FontWeight="SemiBold" Margin="0,4" />
                                <TextBlock Grid.Row="1" Text="延时工时抵扣" Margin="0,4" />
                                <TextBlock x:Name="DayDetailDelayText" Grid.Row="1" Grid.Column="1" Text="0h00m" FontWeight="SemiBold" Margin="0,4" />
                                <TextBlock Grid.Row="2" Text="请假" Margin="0,4" />
                                <TextBlock x:Name="DayDetailLeaveText" Grid.Row="2" Grid.Column="1" Text="0h00m" FontWeight="SemiBold" Margin="0,4" />
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="3" Columns="3">
                            <StackPanel>
                                <TextBlock Text="加班费" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="DayDetailOvertimePayText" Text="¥ 0.00" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="餐补" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="DayDetailMealPayText" Text="¥ 0.00" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="当天合计" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="DayDetailTotalText" Text="¥ 0.00" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Grid.Row="4" Background="#42FFFFFF" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="17,15" Margin="0,22,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="备注与加班证据" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="图片按天独立加密保存，不会并入考勤主缓存" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="添加图片" Padding="13,7" Margin="0,0,8,0" Click="AddEvidenceImageButton_Click" />
                                        <Button Content="导出当天资料" Padding="13,7" Click="ExportDayEvidenceButton_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="DayEvidenceNoteTextBox" MinHeight="72" MaxLength="2000" Padding="11,8"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             ToolTip="记录加班原因、事项或补充说明" />
                                    <Button Grid.Column="1" Content="保存备注" Padding="14,8" Margin="10,0,0,0"
                                            VerticalAlignment="Bottom" Click="SaveDayEvidenceNoteButton_Click" />
                                </Grid>

                                <Grid Margin="0,13,0,0">
                                    <TextBlock x:Name="DayEvidenceEmptyText" Text="暂无证据图片，可添加截图或照片"
                                               Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="DayEvidenceItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="146" Padding="7" Margin="0,0,10,0" Background="#54FFFFFF"
                                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9">
                                                        <StackPanel>
                                                            <Border Height="88" CornerRadius="6" ClipToBounds="True" Background="#180C1726">
                                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                                                                       Margin="2,7,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                                            <Grid Margin="2,4,2,0">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                                <Button Content="删除" Padding="5,1" FontSize="10" HorizontalAlignment="Right"
                                                                        Foreground="{StaticResource DangerBrush}" Background="Transparent"
                                                                        BorderThickness="0" Effect="{x:Null}" Click="DeleteEvidenceImageButton_Click" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                                <TextBlock x:Name="DayEvidenceStatusText" Text="最多 30 张，单张不超过 20 MB"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </Border>

            <Border x:Name="RefreshOverlay" Grid.Row="1" Panel.ZIndex="100" Visibility="Collapsed"
                    Background="#82EDF4FA" IsHitTestVisible="True">
                <Border Width="380" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource GlassCardStyle}">
                    <StackPanel>
                        <TextBlock Text="正在刷新数据" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RefreshOverlayStatusText" Text="正在读取 QHR 数据，请稍候…"
                                   Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,9,0,16" />
                        <ProgressBar Height="6" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                                     Background="#241473E6" BorderThickness="0" />
                        <TextBlock Text="刷新完成后页面会自动恢复操作" Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
