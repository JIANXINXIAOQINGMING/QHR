                                                <TextBlock Text="加班费起算日" Margin="0,0,0,7" />
                                                <DatePicker x:Name="GoalStartDatePicker" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="收入计算方式" Margin="0,0,0,7" />
                                                <ComboBox x:Name="GoalIncomeModeComboBox" SelectedIndex="0">
                                                    <ComboBoxItem Content="只算加班费" />
                                                    <ComboBoxItem Content="加班费 + 餐补" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="16,25,0,0">
                                                <Button Content="保存目标" Style="{StaticResource AccentButtonStyle}"
                                                        Click="SaveGoalButton_Click" />
                                                <Button x:Name="DeleteCurrentGoalButton" Content="删除当前目标"
                                                        Margin="8,0,0,0" Foreground="{StaticResource DangerBrush}"
                                                        Click="DeleteCurrentGoalButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="GoalStatusText" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
