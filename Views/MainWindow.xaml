                                                                <StackPanel><TextBlock Text="累计收入" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding EarnedAmountText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                                                <StackPanel><TextBlock Text="期间消费" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding ExpenseAmountText}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                                            </UniformGrid>
                                                            <TextBlock Text="{Binding OvertimeCompositionText}" Style="{StaticResource MutedTextStyle}" Margin="0,13,0,0" />
