                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="年份" Binding="{Binding Period}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="加班日期数" Binding="{Binding OvertimeDays}" Width="110"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="折算天数" Binding="{Binding EquivalentDays, StringFormat=0.##}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="加班(h)" Binding="{Binding TotalHours, StringFormat=0.##}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="延时抵扣(h)" Binding="{Binding DelayDeductedHours, StringFormat=0.##}" Width="110"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="总加班费" Binding="{Binding GrossOvertimePay, StringFormat=¥ {0:N2}}" Width="115"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="实际加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="120"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="封顶无效(h)" Binding="{Binding CapExcludedHours, StringFormat=0.##}" Width="115"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="封顶少计" Binding="{Binding CapDeductedPay, StringFormat=¥ {0:N2}}" Width="110"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="餐补次数" Binding="{Binding MealAllowanceCount}" Width="95"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="95"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="总计" Binding="{Binding TotalAmount, StringFormat=¥ {0:N2}}" Width="115"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="8,5,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="工时明细" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="在每日、月度和年度三个粒度之间切换。" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,18" />
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <TabControl x:Name="DetailTabs">
                                    <TabItem Header="每日明细">
                                        <DataGrid x:Name="DailyDataGrid" Margin="0,14,0,0" AutoGenerateColumns="False"
                                                  GridLinesVisibility="All" VerticalGridLinesBrush="{StaticResource LineBrush}"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="118"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="首卡" Binding="{Binding ClockInText}" Width="72"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="末卡" Binding="{Binding ClockOutText}" Width="72"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="日期类型" Binding="{Binding DateTypeText}" Width="145">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredDataGridTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DayKind.Holiday}">
                                                                    <Setter Property="Foreground" Value="{StaticResource HolidayBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="原始加班" Binding="{Binding GrossDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="延时抵扣" Binding="{Binding DelayDeductedDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="请假" Binding="{Binding LeaveSummaryText}" Width="155"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="月度事假抵扣" Binding="{Binding LeaveDeductedDurationText}" Width="125"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="封顶前加班" Binding="{Binding HoursDurationText}" Width="105"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="封顶无效" Binding="{Binding CapExcludedDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="有效计费" Binding="{Binding PaidHoursDurationText}" Width="100"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="总加班费" Binding="{Binding GrossOvertimePay, StringFormat=¥ {0:N2}}" Width="105">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredDataGridTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DayKind.Holiday}">
                                                                    <Setter Property="Foreground" Value="{StaticResource HolidayBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="实际加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="110"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="90"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="总合计" Binding="{Binding GrossAmount, StringFormat=¥ {0:N2}}" Width="105"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                                <DataGridTextColumn Header="实际合计" Binding="{Binding Amount, StringFormat=¥ {0:N2}}" Width="105"
                                                                    ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="月度汇总">
                                        <DataGrid x:Name="MonthlyDataGrid" Margin="0,14,0,0" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="月份" Binding="{Binding Period}" Width="*" />
                                                <DataGridTextColumn Header="加班日期数" Binding="{Binding OvertimeDays}" Width="110" />
                                                <DataGridTextColumn Header="折算天数(8h/天)" Binding="{Binding EquivalentDays, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="工作日(h)" Binding="{Binding WorkdayHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="周末(h)" Binding="{Binding WeekendHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="节假日(h)" Binding="{Binding HolidayHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="合计(h)" Binding="{Binding TotalHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="延时抵扣(h)" Binding="{Binding DelayDeductedHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="事假(h)" Binding="{Binding PersonalLeaveHours, StringFormat=0.##}" Width="95" />
                                                <DataGridTextColumn Header="年假(h)" Binding="{Binding AnnualLeaveHours, StringFormat=0.##}" Width="95" />
                                                <DataGridTextColumn Header="事假抵扣(h)" Binding="{Binding LeaveDeductedHours, StringFormat=0.##}" Width="110" />
                                                <DataGridTextColumn Header="封顶无效(h)" Binding="{Binding CapExcludedHours, StringFormat=0.##}" Width="115" />
                                                <DataGridTextColumn Header="总加班费" Binding="{Binding GrossOvertimePay, StringFormat=¥ {0:N2}}" Width="115" />
                                                <DataGridTextColumn Header="实际加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="120" />
                                                <DataGridTextColumn Header="封顶少计" Binding="{Binding CapDeductedPay, StringFormat=¥ {0:N2}}" Width="110" />
                                                <DataGridTextColumn Header="餐补次数" Binding="{Binding MealAllowanceCount}" Width="100" />
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="100" />
                                                <DataGridTextColumn Header="总计" Binding="{Binding TotalAmount, StringFormat=¥ {0:N2}}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="年度汇总">
                                        <DataGrid x:Name="YearlyDataGrid" Margin="0,14,0,0" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="年份" Binding="{Binding Period}" Width="*" />
                                                <DataGridTextColumn Header="加班日期数" Binding="{Binding OvertimeDays}" Width="120" />
                                                <DataGridTextColumn Header="折算天数(8h/天)" Binding="{Binding EquivalentDays, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="工作日(h)" Binding="{Binding WorkdayHours, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="周末(h)" Binding="{Binding WeekendHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="节假日(h)" Binding="{Binding HolidayHours, StringFormat=0.##}" Width="130" />
                                                <DataGridTextColumn Header="合计(h)" Binding="{Binding TotalHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="延时抵扣(h)" Binding="{Binding DelayDeductedHours, StringFormat=0.##}" Width="115" />
                                                <DataGridTextColumn Header="事假(h)" Binding="{Binding PersonalLeaveHours, StringFormat=0.##}" Width="100" />
                                                <DataGridTextColumn Header="年假(h)" Binding="{Binding AnnualLeaveHours, StringFormat=0.##}" Width="100" />
                                                <DataGridTextColumn Header="事假抵扣(h)" Binding="{Binding LeaveDeductedHours, StringFormat=0.##}" Width="115" />
                                                <DataGridTextColumn Header="封顶无效(h)" Binding="{Binding CapExcludedHours, StringFormat=0.##}" Width="120" />
                                                <DataGridTextColumn Header="总加班费" Binding="{Binding GrossOvertimePay, StringFormat=¥ {0:N2}}" Width="120" />
                                                <DataGridTextColumn Header="实际加班费" Binding="{Binding OvertimePay, StringFormat=¥ {0:N2}}" Width="125" />
                                                <DataGridTextColumn Header="封顶少计" Binding="{Binding CapDeductedPay, StringFormat=¥ {0:N2}}" Width="115" />
                                                <DataGridTextColumn Header="餐补次数" Binding="{Binding MealAllowanceCount}" Width="105" />
                                                <DataGridTextColumn Header="餐补" Binding="{Binding MealAllowance, StringFormat=¥ {0:N2}}" Width="105" />
                                                <DataGridTextColumn Header="总计" Binding="{Binding TotalAmount, StringFormat=¥ {0:N2}}" Width="125" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="8,5,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="节假日日历" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="仅法定节假日当天按节假日费率，其余假期休息日按周末、调休上班日按工作日。" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,18" />
                                </StackPanel>
                                <Button x:Name="SyncHolidayButton" Content="立即同步" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Style="{StaticResource AccentButtonStyle}" Click="SyncHolidayButton_Click" />
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="同步状态" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HolidayDetailStatusText" Grid.Column="1" Text="尚未同步" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="1" Text="数据源" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBox x:Name="HolidaySourceDisplayTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                             Margin="0,10,0,0" BorderThickness="0" Background="Transparent" Padding="0" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <DataGrid x:Name="HolidayDataGrid" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="180" />
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="210" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,5,8,18">
                                <TextBlock Text="计算设置" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="“启用月度封顶”开关会立即保存；其他设置点击“保存并重新计算”后生效。"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,7,0,18" />

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="费用参数" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="工作日" Margin="0,0,0,7" /><TextBox x:Name="WorkdayRateTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="周末" Margin="0,0,0,7" /><TextBox x:Name="WeekendRateTextBox" /></StackPanel>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="节假日（元 / 小时）" Margin="0,0,0,7" /><TextBox x:Name="HolidayRateTextBox" /></StackPanel>
                                            <StackPanel><TextBlock Text="每次餐补（元）" Margin="0,0,0,7" /><TextBox x:Name="MealAllowanceTextBox" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="月度加班费封顶" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="超过封顶额度的部分不计发加班费，并记录为封顶无效加班时长。餐补不占用封顶额度。"
                                                   Style="{StaticResource MutedTextStyle}" Margin="0,7,0,16" TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="EnableOvertimePayCapCheckBox" Content="启用月度封顶"
                                                      VerticalAlignment="Top" Margin="0,1,0,0"
                                                      Click="EnableOvertimePayCapCheckBox_Click" />
                                            <StackPanel Grid.Column="1" Margin="0,0,22,0">
                                                <TextBlock Text="每月封顶金额（元）" Margin="0,0,0,7" />
                                                <TextBox x:Name="MonthlyOvertimePayCapTextBox"
                                                         IsEnabled="{Binding IsChecked, ElementName=EnableOvertimePayCapCheckBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <CheckBox x:Name="ExcludeHolidayPayFromCapCheckBox"
                                                          Content="节假日加班费不计入封顶额度"
                                                          IsEnabled="{Binding IsChecked, ElementName=EnableOvertimePayCapCheckBox}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                    <TextBlock x:Name="OvertimeCapEffectiveScopeText" Text="生效范围：全部历史数据"
                                                               Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                                    <Button Content="选择生效范围" Padding="12,6" Margin="14,0,0,0"
                                                            IsEnabled="{Binding IsChecked, ElementName=EnableOvertimePayCapCheckBox}"
                                                            Click="ChooseOvertimeCapScopeButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="工时计算规则" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
