                                                <TextBlock Text="点击日期记一笔" Style="{StaticResource MutedTextStyle}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <Button Content="上个月" Padding="13,7" Margin="0,0,8,0"
                                                        Click="PreviousExpenseMonthButton_Click" />
                                                <Button x:Name="NextExpenseMonthButton" Content="下个月" Padding="13,7" Margin="0,0,8,0"
                                                        Click="NextExpenseMonthButton_Click" />
