<Window x:Class="QHR.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QHR 加班助手" Icon="/Assets/AppIcon.ico" Width="1000" Height="640"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Border Margin="16" CornerRadius="24" Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#CFFFFFFF" BorderThickness="1" Effect="{StaticResource PanelShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12" CornerRadius="18" Background="{StaticResource BrandBrush}">
                <Grid ClipToBounds="True">
                    <Ellipse Width="350" Height="350" Fill="#18FFFFFF" HorizontalAlignment="Left"
                             VerticalAlignment="Top" Margin="-150,-130,0,0" />
                    <Ellipse Width="300" Height="300" Fill="#14FFFFFF" HorizontalAlignment="Right"
                             VerticalAlignment="Bottom" Margin="0,0,-130,-100" />
                    <StackPanel Margin="44" VerticalAlignment="Center">
                        <Border Width="62" Height="62" CornerRadius="18" Background="#EFFFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,28">
                            <TextBlock Text="Q" Foreground="{StaticResource AccentBrush}" FontSize="31"
                                       FontWeight="Bold" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="QHR 加班助手" Foreground="White" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="让每一次加班，都清清楚楚。" Foreground="#DFFFFFFF" FontSize="15"
                                   Margin="0,12,0,34" />
                        <StackPanel>
                            <TextBlock Text="✓  自动读取 QHR 打卡记录" Foreground="White" Margin="0,7" />
                            <TextBlock Text="✓  年 / 月 / 日三级汇总" Foreground="White" Margin="0,7" />
                            <TextBlock Text="✓  节假日自动同步与本地缓存" Foreground="White" Margin="0,7" />
                            <TextBlock Text="✓  加班费率与计算规则可配置" Foreground="White" Margin="0,7" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,10,0">
                    <Button Style="{StaticResource IconButtonStyle}" Content="—" Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="✕" Click="CloseButton_Click" />
                </StackPanel>

                <Border Grid.Row="1" Width="430" Padding="36" Style="{StaticResource GlassCardStyle}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="欢迎回来" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="凭据由 Windows 凭据管理器安全保管，不写入配置文件。"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,8,0,24" />

                        <TextBlock Text="登录方式" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <ComboBox x:Name="LoginModeCombo" SelectedIndex="0" SelectionChanged="LoginModeCombo_SelectionChanged">
                            <ComboBoxItem Tag="sso">SSO 账号密码</ComboBoxItem>
                            <ComboBoxItem Tag="token">已有 QHR Token</ComboBoxItem>
                        </ComboBox>

                        <StackPanel x:Name="UsernamePanel" Margin="0,18,0,0">
                            <TextBlock Text="账号" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBox x:Name="UsernameTextBox" Height="42" />
                        </StackPanel>

                        <TextBlock x:Name="SecretLabel" Text="密码" FontWeight="SemiBold" Margin="0,18,0,7" />
                        <PasswordBox x:Name="SecretPasswordBox" Height="42" KeyDown="SecretPasswordBox_KeyDown" />

                        <CheckBox x:Name="RememberUsernameCheckBox" Content="自动登录（使用 Windows 凭据管理器）"
                                  IsChecked="True" Margin="0,15,0,0" />

                        <Border x:Name="ErrorBorder" Background="#18E35D67" BorderBrush="#60E35D67"
                                BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>

                        <Button x:Name="LoginButton" Content="登录并进入" Style="{StaticResource AccentButtonStyle}"
                                Height="44" Margin="0,22,0,0" Click="LoginButton_Click" />
                        <TextBlock x:Name="LoginStatusText" Text="直连 SSO，仅用于获取当前会话 token"
                                   Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,13,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
