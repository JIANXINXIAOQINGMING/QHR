<Window x:Class="QHR.Views.BackupPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份密码" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Margin="14" Padding="26" CornerRadius="18" Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#CFFFFFFF" BorderThickness="1" Effect="{StaticResource PanelShadow}">
        <StackPanel>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="设置备份密码" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="此密码用于在另一台电脑上解密备份"
                               Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0" />
                </StackPanel>
                <Button Content="×" Width="32" Height="32" Padding="0" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Effect="{x:Null}"
                        FontSize="21" Click="CancelButton_Click" />
            </Grid>

            <Border Margin="0,20,0,18" Padding="14,12" CornerRadius="11"
                    Background="#171473E6" BorderBrush="#381473E6" BorderThickness="1">
                <TextBlock x:Name="SecurityNoticeText"
                           Text="备份包含考勤、消费、备注和证据图片，但不包含 SSO 密码。密码遗失后无法恢复备份。"
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
            </Border>

            <TextBlock Text="备份密码" Margin="1,0,0,7" />
            <PasswordBox x:Name="PasswordInput" Padding="11,8" MaxLength="128" />
            <TextBlock x:Name="PasswordHintText" Text="至少 8 个字符" Style="{StaticResource MutedTextStyle}"
                       FontSize="11" Margin="2,5,0,0" />

            <StackPanel x:Name="ConfirmPasswordPanel" Margin="0,15,0,0">
                <TextBlock Text="再次输入密码" Margin="1,0,0,7" />
                <PasswordBox x:Name="ConfirmPasswordInput" Padding="11,8" MaxLength="128" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="2,12,0,0"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Padding="18,8" Margin="0,0,9,0" Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton" Content="继续备份" Padding="18,8"
                        Style="{StaticResource AccentButtonStyle}" Click="ConfirmButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
