<Window x:Class="QHR.Views.QhrCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QHR 请求诊断" Icon="/Assets/AppIcon.ico"
        Width="1500" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#DFF5F9FC" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="Q" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="QHR 请求诊断" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="BrowserStatusText" Text="正在初始化内置浏览器…" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                <Button Style="{StaticResource IconButtonStyle}" Content="—" Click="MinimizeButton_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource IconButtonStyle}" Content="□" Click="MaximizeButton_Click" />
                <Button Style="{StaticResource IconButtonStyle}" Content="✕" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="14,12,14,8" Padding="14,11" Background="#151473E6"
                BorderBrush="#281473E6" BorderThickness="1" CornerRadius="11">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="请在左侧登录 QHR，并依次打开考勤、打卡记录及月份切换等页面。所有请求都会记录，密码、Cookie 和 Token 会自动脱敏。"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="响应正文仅抓取 quectel.com 的 JSON，最大 1 MB；诊断文件只保存在本机。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <CheckBox x:Name="IncludeResponseBodyCheckBox" Grid.Column="1" Content="包含 JSON 响应正文"
                          IsChecked="True" Margin="20,0,5,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14,0,14,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="‹" Width="38" Padding="0" Margin="0,0,6,0" Click="BackButton_Click" />
                <Button Content="↻" Width="38" Padding="0" Margin="0,0,9,0" Click="ReloadButton_Click" />
            </StackPanel>
            <TextBox x:Name="AddressTextBox" Grid.Column="1" Height="40" KeyDown="AddressTextBox_KeyDown" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="9,0,0,0">
                <Button Content="访问" Margin="0,0,8,0" Click="GoButton_Click" />
                <Button x:Name="CaptureToggleButton" Content="暂停记录" Margin="0,0,8,0" Click="CaptureToggleButton_Click" />
                <Button Content="清空" Margin="0,0,8,0" Click="ClearButton_Click" />
                <Button Content="完成并导出" Style="{StaticResource AccentButtonStyle}" Click="FinishButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="600" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
                <wv2:WebView2 x:Name="Browser" Margin="1" />
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="12" Effect="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.1*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="3,0,3,10">
                        <TextBlock Text="已捕获请求" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border x:Name="CaptureStateBorder" Background="#181B9A68" CornerRadius="9" Padding="9,4">
                                <TextBlock x:Name="CaptureStateText" Text="记录中" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                            <TextBlock x:Name="CaptureCountText" Text="0 条" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="CaptureDataGrid" Grid.Row="1" AutoGenerateColumns="False"
                              SelectionChanged="CaptureDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="95" />
                            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="68" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="62" />
                            <DataGridTextColumn Header="类型" Binding="{Binding ResourceType}" Width="82" />
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" Height="6" Background="Transparent" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="CaptureDetailsTextBox" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                             FontSize="12" Background="#BFFFFFFF" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
